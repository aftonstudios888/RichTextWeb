<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <!-- This host facade contains no XAML/PRI resources; the consuming app builds its own resources. -->
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <!-- GetPriOutputs runs in consuming applications, independently of NuGet Pack.
         Do not advertise a nonexistent facade PRI to the app's resource merger. -->
    <IncludeProjectPriFile>false</IncludeProjectPriFile>
    <GenerateLibraryLayout>false</GenerateLibraryLayout>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Description>WinUI 3 WebView2 host for the RichTextWeb JavaScript rich text engine.</Description>
    <AddPriFileDependsOn>$(AddPriFileDependsOn);RichTextWebCheckPriForPack</AddPriFileDependsOn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Shared/RichTextWeb.Bridge.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(WindowsAppSdkVersion)" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="$(WebView2Version)" />
    <Compile Include="../WebView2/CoreWebView2Transport.cs" Link="CoreWebView2Transport.cs" />
  </ItemGroup>
  <!-- NuGet otherwise includes the WinUI SDK's default PRI path even when generation is disabled.
       Check during Pack, after a normal build or against existing outputs for NoBuild=true. -->
  <Target Name="RichTextWebCheckPriForPack" Condition="!Exists('$(ProjectPriFullPath)')">
    <PropertyGroup>
      <IncludeProjectPriFile>false</IncludeProjectPriFile>
    </PropertyGroup>
  </Target>
</Project>
