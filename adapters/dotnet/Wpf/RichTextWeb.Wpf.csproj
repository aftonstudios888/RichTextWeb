<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Description>WPF WebView2 host for the RichTextWeb JavaScript rich text engine.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Shared/RichTextWeb.Bridge.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="$(WebView2Version)" />
    <Compile Include="../WebView2/CoreWebView2Transport.cs" Link="CoreWebView2Transport.cs" />
  </ItemGroup>
</Project>
